# Truth Pool — Environment Configuration Template
# Duplicate this file to .env and provide your actual values.
# NEVER commit .env to source control.

# Database Connection (MySQL / MariaDB / Cloud SQL / RDS / Aiven / PlanetScale)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_secure_db_password
DB_NAME=truth_pool

# Optional Cloud Database TLS/SSL Configuration:
# - DB_SSL_CA: Path to CA certificate bundle (e.g. /etc/ssl/certs/ca-certificates.crt or ./rds-combined-ca-bundle.pem)
# - DB_SSL_DISABLED: Set to 'true' only if connecting via local SSH tunnel or internal VPC without TLS
# - DB_SSL_VERIFY_CERT: Set to 'false' if using self-signed certs (not recommended for production)
# DB_SSL_CA=/path/to/ca-certificate.pem
# DB_SSL_DISABLED=false
# DB_SSL_VERIFY_CERT=true

# Frontend Allowed Origins for CORS (comma-separated, without trailing slashes)
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://truthpool.example.com

# Server Environment ('development' | 'production')
# In 'production':
# - Interactive Swagger UI (/docs, /redoc, /openapi.json) is automatically disabled
# - Development test helper routes (/auth/rate-limit/reset) are disabled
ENVIRONMENT=development

# Rate Limiting (per minute per IP address)
RATE_LIMIT_LOGIN_MAX=30
RATE_LIMIT_REGISTER_MAX=20
